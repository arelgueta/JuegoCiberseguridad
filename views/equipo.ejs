<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>BRECHA — <%= equipo.nombre %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="app-header"><h1><%= equipo.nombre %></h1></header>
  <main>
    <div id="mensaje"></div>

    <div id="banner-ronda" class="tarjeta-sesion" hidden></div>

    <div class="stat-grande">
      <div class="stat">
        <div class="valor" id="valor-presupuesto"><%= equipo.presupuesto %></div>
        <div class="etiqueta">Presupuesto</div>
      </div>
      <div class="stat">
        <div class="valor" id="valor-reputacion"><%= equipo.reputacion %></div>
        <div class="etiqueta">Reputación</div>
      </div>
    </div>

    <div id="tarjeta-pista" class="tarjeta-pista" hidden>
      <span class="pista-etiqueta">Pista de auditoría interna</span>
      <p class="pista-texto"></p>
    </div>

    <h2>Herramientas en uso</h2>
    <div class="compradas-lista" id="lista-compradas"></div>

    <h2>Catálogo</h2>
    <div id="catalogo"></div>
  </main>

  <div id="toast-resultado" class="toast-contenedor"></div>

  <script id="equipo-inicial" type="application/json"><%- JSON.stringify({ id: equipo.id, presupuesto: equipo.presupuesto, reputacion: equipo.reputacion, herramientas: compradas, reaccionoEstaRonda: equipo.reaccionoEstaRonda }) %></script>
  <script id="catalogo-inicial" type="application/json"><%- JSON.stringify(herramientas) %></script>
  <script id="sesion-inicial" type="application/json"><%- JSON.stringify(sesion) %></script>
  <script id="pista-inicial" type="application/json"><%- JSON.stringify(pista) %></script>
  <script id="categorias-info" type="application/json"><%- JSON.stringify(categorias) %></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/equipo.js"></script>
</body>
</html>
