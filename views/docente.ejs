<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>BRECHA — Docente</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="app-header"><h1>BRECHA — Panel del docente</h1></header>
  <main>
    <div id="mensaje"></div>

    <h2>Sesión</h2>
    <div id="panel-sesion" class="panel-sesion"></div>

    <h2>Equipos</h2>
    <table id="tabla-equipos">
      <thead>
        <tr><th>Equipo</th><th>Presupuesto</th><th>Reputación</th><th></th></tr>
      </thead>
      <tbody></tbody>
    </table>

    <h2>Crear equipo</h2>
    <form id="form-crear-equipo" class="formulario">
      <label>Nombre
        <input type="text" name="nombre" required>
      </label>
      <button type="submit">Crear equipo</button>
    </form>

    <h2>Reiniciar</h2>
    <div class="formulario">
      <button id="btn-reset" class="peligro" type="button">Reiniciar partida</button>
      <span class="nota">Mantiene los equipos, borra compras/casos y vuelve todo a 20/20. Distinto de reiniciar el contenedor Docker (que no borra nada).</span>
    </div>
    <div class="formulario">
      <label>Escribí BORRAR para habilitar
        <input type="text" id="input-confirmar-borrar" autocomplete="off">
      </label>
      <button id="btn-borrar-todo" class="peligro" type="button" disabled>Borrar todo (elimina los equipos)</button>
    </div>
  </main>

  <script id="equipos-iniciales" type="application/json"><%- JSON.stringify(equipos) %></script>
  <script id="sesion-inicial" type="application/json"><%- JSON.stringify(sesion) %></script>
  <script id="casos-info" type="application/json"><%- JSON.stringify(casos) %></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/docente.js"></script>
</body>
</html>
