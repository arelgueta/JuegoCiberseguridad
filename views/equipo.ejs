<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>BRECHA — <%= equipo.nombre %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="app-header"><h1><%= equipo.nombre %></h1></header>
  <main>
    <div id="mensaje"></div>

    <div class="stat-grande">
      <div class="stat">
        <div class="valor" id="valor-presupuesto"><%= equipo.presupuesto %></div>
        <div class="etiqueta">Presupuesto</div>
      </div>
      <div class="stat">
        <div class="valor" id="valor-reputacion"><%= equipo.reputacion %></div>
        <div class="etiqueta">Reputación</div>
      </div>
    </div>

    <h2>Herramientas compradas</h2>
    <div class="compradas-lista" id="lista-compradas"></div>

    <h2>Catálogo</h2>
    <% Object.entries(categorias).forEach(([slug, cat]) => { %>
      <% const items = herramientas.filter((h) => h.categoria === slug); %>
      <% if (items.length) { %>
        <div class="categoria-grupo">
          <span class="categoria-titulo" style="background: <%= cat.fondo %>; color: <%= cat.color %>;">
            <%= cat.nombre %>
          </span>
          <% items.forEach((h) => { %>
            <div class="herramienta-card" data-id="<%= h.id %>" data-costo="<%= h.costo %>"
                 style="background: <%= cat.fondo %>;">
              <div class="info">
                <div class="nombre" style="color: <%= cat.color %>;"><%= h.nombre %></div>
                <div class="descripcion"><%= h.descripcion %></div>
              </div>
              <div class="costo">Costo: <%= h.costo %></div>
              <button class="btn-comprar" type="button">Comprar</button>
            </div>
          <% }) %>
        </div>
      <% } %>
    <% }) %>
  </main>

  <script id="equipo-inicial" type="application/json"><%- JSON.stringify({ id: equipo.id, presupuesto: equipo.presupuesto, reputacion: equipo.reputacion, herramientas: compradas }) %></script>
  <script id="herramientas-info" type="application/json"><%- JSON.stringify(herramientas.map((h) => ({ id: h.id, nombre: h.nombre, costo: h.costo }))) %></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/equipo.js"></script>
</body>
</html>
